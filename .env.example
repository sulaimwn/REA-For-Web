# Optional upload service. Static demos work without these settings.
# For local use, npm run dev:uploads prepares everything below automatically.
# Cloudflare frontend only: optional HTTPS origin of the separately hosted upload site.
# REA_UPLOAD_ORIGIN=https://uploads.example.com
PIPELINE_STORAGE=local
PIPELINE_PUBLIC_ORIGIN=http://localhost:3104
REDIS_URL=redis://127.0.0.1:6380
PIPELINE_DATA_ROOT=/absolute/path/to/private/objects
PIPELINE_WORK_ROOT=/absolute/path/to/private/staging
PIPELINE_UPLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
PIPELINE_QUEUE_PREFIX=rea-studio-v1
# Trusted queue worker only. Default 15 minutes; maximum 30 minutes.
REA_ANALYSIS_TIMEOUT_MS=900000
# Per-file deadline. REA retains partial Evidence when a source exceeds it.
REA_SOURCE_TIMEOUT_MS=180000
# Trusted queue only: enable the native image for Ghidra programs and Android JADX.
# npm run dev:uploads defaults this to 1 and builds both images.
REA_NATIVE_WORKER=1

# For R2 instead: set PIPELINE_STORAGE=r2 and an HTTPS public origin.
# Keep the bucket private. Bucket-scoped credentials stay on the server/worker.
# A private beta requires this key before issuing upload tickets.
PIPELINE_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
