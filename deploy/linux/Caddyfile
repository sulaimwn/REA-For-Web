{$UPLOAD_HOST} {
	encode zstd gzip
	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options nosniff
	}
	# Hosted files go directly to private R2. Only small API metadata reaches this proxy.
	request_body {
		max_size 1MB
	}
	reverse_proxy web:3000 {
		# This deployment is directly exposed. Never use a visitor-supplied IP
		# or enable proxy trust behind another CDN without changing this boundary.
		header_up X-REA-Client-IP {remote_host}
	}
}
