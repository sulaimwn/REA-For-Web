(upload_backend) {
	reverse_proxy web:3000 {
		# Direct DNS-only host; never trust a visitor-supplied forwarding header.
		header_up X-REA-Client-IP {remote_host}
	}
}

{$UPLOAD_HOST} {
	encode zstd gzip
	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options nosniff
	}
	@artifact {
		method PUT
		path_regexp artifact ^/api/uploads/[a-f0-9-]{36}/file$
	}
	handle @artifact {
		request_body {
			max_size 512MiB
		}
		import upload_backend
	}
	handle {
		request_body {
			max_size 1MB
		}
		import upload_backend
	}
}
