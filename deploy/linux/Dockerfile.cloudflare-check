# Local compatibility check only; this image never deploys or receives credentials.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1 WRANGLER_SEND_METRICS=false
COPY . .
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build:packages \
    && npm run cf:build --workspace=@rea-studio/web
WORKDIR /repo/apps/web
CMD ["npx", "--no-install", "opennextjs-cloudflare", "preview", "--env", "offline", "--ip", "0.0.0.0", "--port", "8787"]
