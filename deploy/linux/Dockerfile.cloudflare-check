# Local compatibility check only; this image never deploys or receives credentials.
FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1 WRANGLER_SEND_METRICS=false
COPY . .
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build:packages \
    && npm run cf:build --workspace=@rea-studio/web
WORKDIR /repo/apps/web
CMD ["npx", "--no-install", "opennextjs-cloudflare", "preview", "--ip", "0.0.0.0", "--port", "8787"]
