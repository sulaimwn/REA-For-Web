# Root-owned /etc/rea-for-web/web.env, mode 600. Never put real values in Git.
PIPELINE_STORAGE=local
PIPELINE_HOSTED_LOCAL=1
PIPELINE_PUBLIC_UPLOADS=0
PIPELINE_TURNSTILE=0
PIPELINE_PUBLIC_ORIGIN=https://uploads.example.com
PIPELINE_QUEUE_PREFIX=rea-production-v1
PIPELINE_WORK_ROOT=/var/lib/rea-for-web/staging
PIPELINE_DATA_ROOT=/var/lib/rea-for-web/objects
PIPELINE_ACCESS_KEY=replace-with-existing-private-owner-key
PIPELINE_UPLOAD_SECRET=replace-with-at-least-32-random-characters
PIPELINE_VISITOR_LIMITS=1
PIPELINE_TRUST_PROXY=1
PIPELINE_VISITOR_SECRET=replace-with-a-separate-at-least-32-character-random-secret
# First public release sets PUBLIC_UPLOADS=1 after review and disk verification.
# Later bot-check release sets TURNSTILE=1 with production keys, both on web only.
# TURNSTILE_SITE_KEY=the-public-widget-site-key
# TURNSTILE_SECRET_KEY=the-private-widget-secret
# No R2 credentials needed. Compose injects the private Redis address.
