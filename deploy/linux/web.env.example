# Copy OUTSIDE the repository to /etc/rea-for-web/web.env (root-owned, mode 600).
PIPELINE_STORAGE=r2
PIPELINE_PUBLIC_ORIGIN=https://uploads.example.com
PIPELINE_WORK_ROOT=/var/lib/rea-for-web/staging
PIPELINE_QUEUE_PREFIX=rea-production-v1
PIPELINE_ACCESS_KEY=replace-with-at-least-32-random-characters
# Optional network quotas: 5 tickets/UTC hour, 15/UTC day. Does not remove beta key.
# Enable only behind this Caddyfile, with the web port restricted to loopback.
PIPELINE_VISITOR_LIMITS=0
# PIPELINE_TRUST_PROXY=1
# PIPELINE_VISITOR_SECRET=replace-with-a-separate-32-character-or-longer-random-secret
R2_ACCOUNT_ID=replace-with-the-32-character-account-id
R2_BUCKET=replace-with-the-private-bucket-name
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-object-read-write-key
R2_SECRET_ACCESS_KEY=replace-with-the-secret-key
# Compose injects the private Redis container address. The web service has no Docker access.
