{
  "name": "@rea-studio/rea-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js"
    },
    "./native-session": {
      "types": "./dist/native-session.d.ts",
      "import": "./dist/native-session.js"
    },
    "./android-session": {
      "types": "./dist/android-session.d.ts",
      "import": "./dist/android-session.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run build --workspace=@rea-studio/schema && tsc -p tsconfig.tests.json && node --test dist-tests/tests/*.test.js"
  },
  "dependencies": {
    "@rea-studio/schema": "0.0.0"
  }
}
