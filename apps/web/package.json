{
  "name": "@rea-studio/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo-data": "node scripts/build-demo-projects.mjs",
    "predev": "npm run demo-data",
    "dev": "next dev",
    "prebuild": "npm run demo-data",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "tours": "node scripts/generate-tours.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@rea-studio/ask": "0.0.0",
    "@rea-studio/rea-adapter": "0.0.0",
    "@rea-studio/schema": "0.0.0",
    "@xyflow/react": "12.12.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "4.148.0"
  }
}
