// Cloudflare Workers config for the REA Studio website (built with @opennextjs/cloudflare).
// Deploy with `npm run cf:deploy -w @rea-studio/web` (Linux/CI; see docs/deploy-cloudflare.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reaforweb",
  "main": ".open-next/worker.js",
  // 2025-05-05 or later avoids "FinalizationRegistry is not defined" (OpenNext troubleshooting).
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The hosted service was verified with real private uploads (T039).
  // Keep the dashboard runtime setting on subsequent GitHub deployments.
  "vars": { "REA_UPLOAD_ORIGIN": "https://uploads.reaforweb.com" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Free Ask tier (T030). The account was confirmed on Workers Free ($0) on 2026-10-13 (T038). There, Workers AI stops
  // at the daily allocation instead of billing. Workers Paid bills past it: remove this binding BEFORE upgrading.
  // Optional per-visitor limit across the edge (if the account offers it):
  // "ratelimits": [{ "name": "ASK_FREE_LIMITER", "namespace_id": "3001", "simple": { "limit": 12, "period": 60 } }],
  "ai": { "binding": "AI" },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "reaforweb"
    }
  ],
  // Attach the domain once it's on your Cloudflare account (docs/deploy-cloudflare.md, step 4):
  // "routes": [
  //   { "pattern": "reaforweb.com", "custom_domain": true },
  //   { "pattern": "www.reaforweb.com", "custom_domain": true }
  // ],
  "observability": { "enabled": true },
  // Credential-free local previews: `opennextjs-cloudflare preview --env offline`. Bindings aren't inherited
  // by environments, so this one has no Workers AI binding (which always needs a Cloudflare login);
  // the free Ask tier then answers 503 and the panel offers the Claude-key option.
  "env": {
    "offline": {
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "reaforweb-offline" }]
    }
  }
}
