# Native-program worker (T024): the standard worker image plus the external tools REA drives for
# programs it can't read itself. REA never downloads these; each is pinned and checksum-verified here.
#   - JDK 21 (Eclipse Temurin 21.0.12.1): Ghidra runs on it and compiles REA's bridge scripts with javac.
#   - Ghidra 12.1.4 (NSA, Apache-2.0): REA's provider for native code (.exe/.dll, ELF, Mach-O).
#   - jadx-headless-mcp 0.7.1 (Apache-2.0): REA's JADX provider for Android APKs, at the release
#     and SHA-256 REA 6.7.0 pins in its JadxRelease (JAR unchanged from 6.4.0;
#     the matching bridge is bundled with the installed REA package).
# Build the standard image first, from the same checkout:
#   docker build -f apps/worker/Dockerfile -t rea-studio-worker:rea-6.7.0 .
#   docker build -f apps/worker/Dockerfile.native -t rea-studio-worker-native:rea-6.7.0 .
# Analysis containers still have no network; these downloads happen only at image build time.
ARG BASE_IMAGE=rea-studio-worker:rea-6.7.0

FROM eclipse-temurin:21-jdk-noble@sha256:b468c3fc688b14450571494f588bd939378e7fd542ed5a73f8efc13f17872a87 AS jdk
# jmods are only for jlink; Ghidra needs the runtime and the compiler, which live in lib/.
RUN rm -rf /opt/java/openjdk/jmods

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS tools
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db \
    https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip /tmp/ghidra.zip
# unzip keeps the release's executable bits (support/analyzeHeadless, the decompiler).
# Windows/macOS binaries, docs and IDE extensions are not needed by headless analysis on Linux.
RUN unzip -q /tmp/ghidra.zip -d /opt && mv /opt/ghidra_12.1.4_PUBLIC /opt/ghidra && rm /tmp/ghidra.zip \
    && find /opt/ghidra -type d -path '*/os/*' \( -name 'win_*' -o -name 'mac_*' \) -prune -exec rm -rf {} + \
    && rm -rf /opt/ghidra/docs /opt/ghidra/Extensions/Eclipse /opt/ghidra/Extensions/IDAPro \
    && test -x /opt/ghidra/support/analyzeHeadless
ADD --checksum=sha256:6e5eacf500b64292bfb73c49797c1958f6ee44646e43e868039ae7feb573ff75 \
    https://github.com/1013503897/jadx-headless-mcp/releases/download/v0.7.1/jadx-headless-mcp-0.7.1-all.jar /opt/jadx/jadx-headless-mcp-0.7.1-all.jar
RUN chmod 644 /opt/jadx/jadx-headless-mcp-0.7.1-all.jar

FROM ${BASE_IMAGE}
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
COPY --from=tools /opt/ghidra /opt/ghidra
COPY --from=tools /opt/jadx /opt/jadx
ENV JAVA_HOME=/opt/java/openjdk \
    GHIDRA_INSTALL_DIR=/opt/ghidra \
    REA_JADX_MCP_JAR=/opt/jadx/jadx-headless-mcp-0.7.1-all.jar
